йопта делится(х) {
    отвечаю х % 7 конкретно 0;
}

гыы сумма = 0;
гыы и = 0;

потрещим (правда) {
    и = и + 1;
    вилкойвглаз (и пизже 20000) {
        харэ;
    }
    вилкойвглаз (лож) {
        сумма = сумма + 1000;
    }
    вилкойвглаз (чобля делится(и)) {
        сумма = сумма + 1;
        двигай;
    }
    сумма = сумма + 2;
}

сказать(сумма);
