клёво Счёт {
    Счёт(начало) {
        тырыпыры.значение = начало;
    }

    добавить(н) {
        тырыпыры.значение = тырыпыры.значение + н;
        отвечаю тырыпыры.значение;
    }

    шаг() {
        отвечаю тырыпыры.добавить(1);
    }

    вес() {
        отвечаю 1;
    }
}

клёво Двойной батя Счёт {
    Двойной(начало) {
        яга(начало);
    }

    вес() {
        отвечаю 2;
    }
}

гыы база = захуярить Счёт(0);
гыы под = захуярить Двойной(0);
гыы сумма = 0;

го (гыы и = 0; и < 6000; и++) {
    сумма += база.шаг();
    сумма += под.шаг();
    сумма += база.вес();
    сумма += под.вес();
}

сказать(сумма);
