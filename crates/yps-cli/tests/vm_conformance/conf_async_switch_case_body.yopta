ассо йопта ф(н) { отвечаю н; }
ассо йопта проверить(к) {
    базарпо (к) {
        тема 1: { сказать("один:", сидетьНахуй ф("а")); }
        тема 2: { сказать("два:", сидетьНахуй ф("б")); }
        нуичо { сказать("иначе:", сидетьНахуй ф("в")); }
    }
}
ассо йопта главная() {
    сидетьНахуй проверить(1);
    сидетьНахуй проверить(2);
    сидетьНахуй проверить(9);
    сказать("конец");
}
главная();
сказать("синхронный хвост");
