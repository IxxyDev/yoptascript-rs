го (м сашаГрей "foo=1, bar=2".найтиВсе(/(\w+)=(\d+)/g)) {
    сказать(м["1"] + "=" + м["2"]);
}

гыы все = [..."x=7, y=8".найтиВсе(/(\w+)=(\d+)/g)];
сказать(все.длина);
го (м сашаГрей все) {
    сказать(м["0"]);
}

гыы [первый, второй] = [..."a=1, b=2".найтиВсе(/(\w+)=(\d+)/g)];
сказать(первый["1"]);
сказать(второй["1"]);

гыы дин = RegExp("\\d+", "g");
сказать("год 2026 век 21".совпадает(дин));

гыы стейт = /\d/g;
стейт.последнийИндекс = 0;
сказать(стейт.найти("a1b2")["0"]);
сказать(стейт.последнийИндекс);
