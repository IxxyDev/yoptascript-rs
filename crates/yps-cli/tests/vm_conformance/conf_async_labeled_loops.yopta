ассо йопта главная() {
    внешний: го (гыы и = 0; и < 3; и += 1) {
        го (гыы ж = 0; ж < 3; ж += 1) {
            вилкойвглаз (ж === 1) { двигай внешний; }
            сказать("продолжение", сидетьНахуй СловоПацана.решить(и * 10 + ж));
        }
    }
    выход: го (гыы и = 0; и < 3; и += 1) {
        го (гыы ж = 0; ж < 3; ж += 1) {
            вилкойвглаз (и === 1) { харэ выход; }
            сказать("выходной", сидетьНахуй СловоПацана.решить(и * 10 + ж));
        }
    }
    сказать("конец");
}
главная();
сказать("синхронный хвост");
