гыы а = 0; гыы б = 0; гыы остаток = [];
[а, б] = [1, 2];
сказать(а + " " + б);
[а, ...остаток] = [10, 20, 30];
сказать(а);
сказать(остаток);
гыы х = 0; гыы у = 0;
({х, у} = {х: 5, у: 6});
сказать(х + " " + у);
гыы п = 0;
[п = 9] = [];
сказать(п);
[п = 9] = [4];
сказать(п);
гыы об = {};
[об.поле] = [77];
сказать(об.поле);
гыы масс = [0, 0];
[масс[1], масс[0]] = ["a", "b"];
сказать(масс);
гыы пр = {}; гыы ост2 = {};
({пр: пр, ...ост2} = {пр: 1, ещё: 2, третий: 3});
сказать(пр);
сказать(ост2);
гыы вложА = 0; гыы вложБ = 0;
[[вложА], {к: вложБ}] = [[8], {к: 9}];
сказать(вложА + " " + вложБ);
гыы клч = "динам"; гыы знач = 0;
({[клч]: знач} = {динам: 42});
сказать(знач);
гыы рез = ([а, б] = [7, 8]);
сказать(рез);
(а) = 100;
сказать(а);
йопта ф3() {
  гыы л = 1;
  гыы а=0; гыы б=0; гыы ост={};
  гыы к1 = "п1"; гыы к2 = "п2";
  сказать(л + 1);
  ({[к1]: а, [к2]: б, ...ост} = {п1: 1, п2: 2, п3: 3, п4: 4});
  сказать(а + " " + б);
  сказать(ост);
  гыы объ = {вн: {}};
  ({[к1]: объ.вн.г = 55} = {});
  сказать(объ.вн.г);
  гыы масс = [];
  го (гыы и = 0; и < 3; и += 1) {
    гыы т = 0;
    [т] = [и * 2];
    масс.втолкнуть(() => т);
  }
  сказать(масс.преобразовать(ф2 => ф2()));
  гыы сч = 0;
  йопта поб() { сч += 1; отвечаю "к" + сч; }
  гыы з1 = 0; гыы ост2 = {};
  ({[поб()]: з1, ...ост2} = {к1: 11, к2: 22});
  сказать(з1);
  сказать(ост2);
  сказать(сч);
}
ф3();
йопта ф2в() {
  гыы л1 = 1; гыы л2 = 2; гыы а = 0; гыы б = 0;
  сказать(л1 + л2);
  сказать([а, б] = [7, 8]);
  сказать(а + " " + б);
  гыы масс = [0,0];
  сказать(1 + ([масс[0], масс[1]] = [3,4]).длина);
  сказать(масс);
  гыы х = 0;
  сказать([({х} = {х: 5}), х]);
}
ф2в();
